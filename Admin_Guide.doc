  font-size: 10.5pt;
  color: #44403c;
}
ul, ol {
  margin-top: 5px;
  margin-bottom: 15px;
  padding-left: 20px;
}
li {
  margin-bottom: 6px;
}
.note-box {
  background-color: #eff6ff;
  border-left: 5px solid #2563eb;
  padding: 12px 18px;
  margin: 18px 0;
  border-radius: 4px;
}
